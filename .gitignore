# ---------------------------------------------------------------------------
# Build output. Everything here is 100% regenerable with:
#     cmake -B build -S . && cmake --build build
# ---------------------------------------------------------------------------
build/
# build-asan, build-release, ... (sanitizer builds: see docs/COMMANDS.md sec.6)
build-*/
# CLion's default build directory naming
cmake-build-*/

# CMake scratch, regenerated by `cmake -B build -S .`
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt
Makefile
*.cmake.in

# Compiled objects, libraries, executables, debug info
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.dSYM/
*.gcda
*.gcno
*.profraw
*.profdata

# The compiler binary and test binaries (regenerated by `cmake --build build`)
dslc
test_smoke
test_lexer
test_parser
test_sema
test_ir
test_opt
test_e2e

# Compilation database, regenerated by:
#     cmake -B build -S . -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
compile_commands.json

# ---------------------------------------------------------------------------
# Generated test data. None of this is source; it is produced on demand and is
# large, so it is never committed. Regenerate with:
#     ctest --test-dir build --output-on-failure      (test outputs, logs)
#     cmake --build build && ./build/dslc examples/<prog>.dsl --emit=ir   (IR dumps)
# Fuzz corpora / crash inputs, if ever added, are regenerated by re-running the
# fuzzer; only a minimized reproducer belongs in the repo, added explicitly.
# ---------------------------------------------------------------------------
*.pcap
*.pcapng
corpus/
fuzz-corpus/
crash-*
leak-*
timeout-*
oom-*
*.bench
bench-out/
testdata-gen/
*.ir.out
*.bc.out
*.actual
*.log

# ---------------------------------------------------------------------------
# Local scratch programs — write throwaway .dsl here without dirtying git status
# ---------------------------------------------------------------------------
examples/scratch_*.dsl
examples/myprog.dsl

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
.cache/
.clangd/
*.swp
*.swo
*~
